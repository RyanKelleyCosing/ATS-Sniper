    "ATS_SNIPER_DISABLE_CUSTOM_SCRAPER": "true",
    "ATS_SNIPER_MORNING_CRON": "0 30 13 * * *",
    "ATS_SNIPER_AFTERNOON_CRON": "0 30 20 * * *",
    "ATS_SNIPER_MONITOR_MORNING_CRON": "0 15 15 * * *",
    "ATS_SNIPER_MONITOR_AFTERNOON_CRON": "0 45 21 * * *"
  }
}
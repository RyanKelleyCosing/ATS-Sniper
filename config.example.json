    "morning": {
      "time": "09:30",
      "description": "Broad morning sweep across enterprise, startup ATS, and gap-filling web discovery",
      "query_groups": ["enterprise_workday", "enterprise_other", "enterprise_consulting", "startup_ats", "cincy_regional"]
    },
    "afternoon": {
      "time": "16:30",
      "description": "Startup Sweep - Catches EOD posts + West Coast morning",
      "query_groups": ["startup_ats", "niche_boards"]
    },
    "lightweight": {
      "times": ["11:30", "14:30", "18:30"],
      "description": "Freshness-first pass for direct APIs and web discovery between full runs",
      "query_groups": ["enterprise_workday", "enterprise_other", "startup_ats", "cincy_regional"]
    },
    "fresh_watch": {
      "start_time": "10:35",
      "end_time": "16:15",
      "interval_minutes": 10,
      "description": "10-minute web-only fresh-watch bridge between morning and afternoon runs"
    }
  },
  "startup_discovery": {
    "enabled": true,
    "max_queries": 5,
    "max_results_per_query": 8,
    "include_adjacent_roles": true,
    "google_query_terms": ["careers at", "careers", "open roles", "open positions", "We're hiring"],
    "allowed_run_types": ["morning", "afternoon", "full", "lightweight", "fresh_watch"]
  },
  "jobspy_discovery": {
    "enabled": false,
    "run_types": ["morning", "afternoon", "full"],
    "site_name": ["indeed", "google"],
    "location": "United States",
